<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="tactics" nsURI="http://www.coresense.eu/adaptation/Tactics"
    nsPrefix="tactics">
  <eClassifiers xsi:type="ecore:EClass" name="TacticsModel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="imports" upperBound="-1"
        eType="ecore:EClass platform:/resource/eu.coresense.common/model/common.ecore#//Import"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tactics" upperBound="-1"
        eType="#//Tactic" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Tactic">
    <eStructuralFeatures xsi:type="ecore:EReference" name="requirement" eType="ecore:EClass platform:/resource/eu.coresense.requirements/model/generated/RequirementsModel.ecore#//Requirement"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ActionTactics" eSuperTypes="#//Tactic">
    <eStructuralFeatures xsi:type="ecore:EReference" name="action" eType="ecore:EClass platform:/resource/de.fraunhofer.ipa.ros/model/ros.ecore#//ActionSpec"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tactics" upperBound="-1"
        eType="#//PureTactic" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PureTactic" eSuperTypes="#//Tactic">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="guard" eType="#//Guard"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="action" eType="#//TacticAction"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Selection">
    <eStructuralFeatures xsi:type="ecore:EReference" name="variant" eType="#//QualifiedFeatureRef"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TacticAction">
    <eStructuralFeatures xsi:type="ecore:EReference" name="actions" upperBound="-1"
        eType="#//Selection" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Guard">
    <eStructuralFeatures xsi:type="ecore:EReference" name="contextGuard" eType="#//ContextGuard"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="featureGuard" eType="#//FeatureGuard"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextGuard">
    <eStructuralFeatures xsi:type="ecore:EReference" name="contextCondition" eType="#//ContextCondition"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureGuard">
    <eStructuralFeatures xsi:type="ecore:EReference" name="featureCondition" eType="#//FeatureCondition"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureCondition">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="not" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="variant" eType="#//QualifiedFeatureRef"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="logicalOp" eType="#//LogicalOperator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secondTerm" eType="#//FeatureCondition"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextCondition">
    <eStructuralFeatures xsi:type="ecore:EReference" name="contextVar" eType="ecore:EClass platform:/resource/eu.coresense.context/model/generated/ContextModel.ecore#//ContextVar"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="operator" eType="ecore:EEnum platform:/resource/eu.coresense.common/model/common.ecore#//MathOperator"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="logicalOp" eType="#//LogicalOperator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="secondTerm" eType="#//ContextCondition"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextThresholdCondition" eSuperTypes="#//ContextCondition">
    <eStructuralFeatures xsi:type="ecore:EReference" name="thresholdValue" eType="ecore:EClass platform:/resource/eu.coresense.common/model/common.ecore#//Literal"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextContextCondition" eSuperTypes="#//ContextCondition">
    <eStructuralFeatures xsi:type="ecore:EReference" name="otherContextVar" eType="ecore:EClass platform:/resource/eu.coresense.context/model/generated/ContextModel.ecore#//ContextVar"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LogicalOperator">
    <eLiterals name="AND" literal="AND"/>
    <eLiterals name="OR" value="1" literal="OR"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SelectVariant" eSuperTypes="#//Selection"/>
  <eClassifiers xsi:type="ecore:EClass" name="DeselectVariant" eSuperTypes="#//Selection"/>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedFeatureRef">
    <eStructuralFeatures xsi:type="ecore:EReference" name="model" eType="ecore:EClass platform:/resource/eu.coresense.resolution/model/generated/ResolutionModel.ecore#//ResolutionModel"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature" eType="ecore:EClass platform:/resource/fms.metamodel/model/BasicFMmetamodel.ecore#//Feature"/>
  </eClassifiers>
</ecore:EPackage>
