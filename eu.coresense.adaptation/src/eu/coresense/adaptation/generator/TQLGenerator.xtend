				«ENDIF»
				«ENDIF»
				 «ENDFOR») 
				 isa resolution_model, 
				    has resolution_model_name "«resolutionModel.name»", has ros_system "«resolutionModel.rossystem.name»";
			«ENDFOR»


		'''
		
//		println(generateFetchQuery(t))
		
		return x
	}
	
	
