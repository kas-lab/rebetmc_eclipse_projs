grammar eu.coresense.adaptation.Tactics with org.eclipse.xtext.common.Terminals

import "http://coresense.eu/resolution/ResolutionModel" as resolutionModel
import "http://www.coresense.eu/variability/FeatureModel" as variabilityModel
import "http://caosd.lcc.uma.es/BasicFMmetamodel" as BasicFMmetamodel
import "http://www.coresense.eu/requirements/RequirementsModel" as requirementsModel
import "http://www.coresense.eu/context/ContextModel" as contextModel
import "http://www.eclipse.org/emf/2002/Ecore" as ecore
import "https://coresense.eu/common" as common
import "http://www.ipa.fraunhofer.de/ros" as ros
generate tactics "http://www.coresense.eu/adaptation/Tactics"

TacticsModel:
	'name' name=ID ';' 
	(imports+=Import*)
	(actionRules+=ActionRules*)
;


ActionRules:
	action=[ros::ActionSpec] requirement=[requirementsModel::Requirement]? "{"
		(adaptationRules+=AdaptationRule*)
	"}"
;


Import returns common::Import:
	'import' importURI=STRING ';'
;

AdaptationRule:
 	AtomicRule
;

AtomicRule:
	'rule' name=ID '{' 
	ruleBody=RuleBody '}' ';'
;

AtomicAction:
    'action' '{' actions+=AtomicSimpleAction ('AND' actions+=AtomicSimpleAction)*'}';
    
AtomicSimpleAction:
    AtomicActionSelectFeature | AtomicActionDeselectFeature;

RuleBody:
	action=TacticAction effect=EffectBlock?
;

TacticAction:
	(PureAction | ConditionAction)
;


PureAction:
	atomicAction=AtomicAction
;

ConditionAction:
    'guard' '{'
        (
            contextGuard=ContextGuard featureGuard=FeatureGuard?
          | featureGuard=FeatureGuard contextGuard=ContextGuard?
        )
        '}'
        atomicAction=AtomicAction;
    
ContextGuard:
    'context' '(' contextCondition=MeasurementCondition ')';

FeatureGuard:
    'features' '(' featureCondition=FeatureCondition ')';

EffectBlock:
	{EffectBlock}
	'effect' '{' someEffect=Effect'}'
;

Effect:
	RelativeEffect
;

RelativeEffect:
	sign=INCDEC effectValue=Literal measurement=[contextModel::ContextVar]
;


FeatureCondition:
	not=('!')? 'selected(' variant=QualifiedFeatureRef ')' 	( logicalOp=LogicalOperator secondTerm=FeatureCondition )? 
;

//
//Condition:
//	MeasurementCondition | FeatureCondition
//;


MeasurementCondition:
	MeasurementThresholdCondition | MeasurementMeasurementCondition
;

MeasurementThresholdCondition:
	measurement=[contextModel::ContextVar]
	operator=MathOperator thresholdValue=Literal 
	( logicalOp=LogicalOperator secondTerm=MeasurementCondition )? 
;

MeasurementMeasurementCondition:
	measurement=[contextModel::ContextVar]
	operator=MathOperator otherMeasurement=[contextModel::ContextVar] 
	( logicalOp=LogicalOperator secondTerm=MeasurementCondition )? 
;

enum MathOperator returns common::MathOperator:
	LESS='<' | GREATER='>' | EQUAL='==' | DIFFERENT='!=' | GREQ='>=' | LEQ='<=' 	
;

enum LogicalOperator:
	AND='AND' | OR='OR' 
;

AtomicActionSelectFeature:
	'select_variant' '(' variant=QualifiedFeatureRef ')'	
;

AtomicActionDeselectFeature:
	'unselect_variant' '('variant=QualifiedFeatureRef')'
;

QualifiedFeatureRef:
    model=[resolutionModel::ResolutionModel] '.' feature=[BasicFMmetamodel::Feature]
;

Literal returns common::Literal:
	IntLiteral
    | DecimalLiteral
    | StringLiteral
    | BooleanLiteral
;

IntLiteral returns common::IntLiteral:
    value=INT
;

DecimalLiteral returns common::DecimalLiteral:
    value=DECIMAL
;

StringLiteral returns common::StringLiteral:
    value=STRING
;

BooleanLiteral returns common::BooleanLiteral:
    value=BOOLEAN
;

terminal DECIMAL returns ecore::EBigDecimal:
    INT '.' INT
;

terminal BOOLEAN returns ecore::EBoolean:
    'true' | 'false'
;

terminal INCDEC returns ecore::EString:
	'+' | '-'
;
