	def Pair<CharSequence, String> ParamValueToValueEntity(ParameterValue the_value) {
		
		val param_str = ParamValueToString(the_value)
//		println("ta " + param_str)
		if(the_value instanceof ParameterSequence)
		{
		val result = newArrayList
		val parseq_name = name_a_paramseq(the_value)
		val body = '''
				$«parseq_name» isa ParameterArray;
				«FOR param_value : the_value.value.indexed»
					«describeParameter(name_a_paramval(param_value.value), param_value.value)»
					$«parseq_name»_elem_«param_value.key» (parameter_array: $«parseq_name», parameter_value: $«name_a_paramval(param_value.value)») isa at_index, has parameter_value_index «param_value.key»;
				«ENDFOR»
				
			'''
		// Insert end thing for the actual array :-)
		for (param_value : the_value.value) {
			result.add(name_a_paramval(param_value))
		}
		return body -> parseq_name
		} 
		else
		{
			val name = name_a_paramval(the_value)
			val single = describeParameter(name, the_value)
			return single -> name
		}
	}
	
