<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="tactics" nsURI="http://www.coresense.eu/adaptation/Tactics"
    nsPrefix="tactics">
  <eClassifiers xsi:type="ecore:EClass" name="TacticsModel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="imports" upperBound="-1"
        eType="#//Import" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="adaptationRules" upperBound="-1"
        eType="#//AdaptationRule" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Import">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="importURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AdaptationRule">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AtomicRule" eSuperTypes="#//AdaptationRule">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ruleBody" eType="#//RuleBody"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RuleSet" eSuperTypes="#//AdaptationRule">
    <eStructuralFeatures xsi:type="ecore:EReference" name="atomicRules" upperBound="-1"
        eType="#//AtomicRuleWithPriority" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AtomicRuleWithPriority">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priorityValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ruleBody" eType="#//RuleBody"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AtomicAction">
    <eStructuralFeatures xsi:type="ecore:EReference" name="actions" upperBound="-1"
        eType="#//AtomicSimpleAction" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AtomicSimpleAction">
    <eStructuralFeatures xsi:type="ecore:EReference" name="variant" eType="#//QualifiedFeatureRef"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RuleBody">
    <eStructuralFeatures xsi:type="ecore:EReference" name="effect" eType="#//EffectBlock"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="atomicAction" eType="#//AtomicAction"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EffectBlock">
    <eStructuralFeatures xsi:type="ecore:EReference" name="someEffect" eType="#//Effect"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Effect"/>
  <eClassifiers xsi:type="ecore:EClass" name="RelativeEffect" eSuperTypes="#//Effect">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sign" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="effectValue" eType="ecore:EClass platform:/resource/eu.coresense.common/model/common.ecore#//Literal"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="measurement" eType="ecore:EClass platform:/resource/eu.coresense.context/model/generated/ContextModel.ecore#//ContextVar"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PureAction" eSuperTypes="#//RuleBody"/>
  <eClassifiers xsi:type="ecore:EClass" name="ConditionAction" eSuperTypes="#//RuleBody">
    <eStructuralFeatures xsi:type="ecore:EReference" name="guardCondition" eType="#//GuardCNF"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GuardCNF">
    <eStructuralFeatures xsi:type="ecore:EReference" name="clauses" upperBound="-1"
        eType="#//GuardDisjunct" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GuardDisjunct">
    <eStructuralFeatures xsi:type="ecore:EReference" name="terms" upperBound="-1"
        eType="#//GuardAtom" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GuardAtom"/>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureSelection" eSuperTypes="#//GuardAtom">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="not" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="variant" eType="#//QualifiedFeatureRef"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextComparison" eSuperTypes="#//GuardAtom">
    <eStructuralFeatures xsi:type="ecore:EReference" name="left" eType="#//ContextOperand"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="operator" eType="ecore:EEnum platform:/resource/eu.coresense.common/model/common.ecore#//MathOperator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="right" eType="#//ContextOperand"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextOperand"/>
  <eClassifiers xsi:type="ecore:EClass" name="ContextVariableOperand" eSuperTypes="#//ContextOperand">
    <eStructuralFeatures xsi:type="ecore:EReference" name="variable" eType="ecore:EClass platform:/resource/eu.coresense.context/model/generated/ContextModel.ecore#//ContextVar"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LiteralOperand" eSuperTypes="#//ContextOperand">
    <eStructuralFeatures xsi:type="ecore:EReference" name="literal" eType="ecore:EClass platform:/resource/eu.coresense.common/model/common.ecore#//Literal"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LogicalOperator">
    <eLiterals name="AND" literal="AND"/>
    <eLiterals name="OR" value="1" literal="OR"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AtomicActionSelectFeature" eSuperTypes="#//AtomicSimpleAction"/>
  <eClassifiers xsi:type="ecore:EClass" name="AtomicActionDeselectFeature" eSuperTypes="#//AtomicSimpleAction"/>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedFeatureRef">
    <eStructuralFeatures xsi:type="ecore:EReference" name="model" eType="ecore:EClass platform:/resource/eu.coresense.resolution/model/generated/ResolutionModel.ecore#//ResolutionModel"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature" eType="ecore:EClass platform:/resource/fms.metamodel/model/BasicFMmetamodel.ecore#//Feature"/>
  </eClassifiers>
</ecore:EPackage>
