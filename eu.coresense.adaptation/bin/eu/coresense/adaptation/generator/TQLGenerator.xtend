    def String getPackage(RosNode node) {
	    val fromFeature = node.eClass.getEStructuralFeature("from")
	    val crossRefNodes = NodeModelUtils.findNodesForFeature(node, fromFeature)
	    if (crossRefNodes.empty) return null
	    val INode crossRefNode = crossRefNodes.head
	    
	    val raw = crossRefNode.getText.trim.substring(1)

	   	if (raw !== null && raw.contains(".")) {
	        return raw.split("\\.").get(0)
	    }
	    return null
	}
	
	    
