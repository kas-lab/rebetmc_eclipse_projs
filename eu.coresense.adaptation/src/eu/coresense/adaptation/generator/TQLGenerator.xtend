	def registerConstraints(EList<CrossTreeConstraint> list) {
			val result = new StringBuilder()
			for (constraint : list) {
				val adv_const = constraint as AdvancedConstraint
				val lhs = _namer.uniqueName(adv_const.term.feature)
				val rhs = _namer.uniqueName(adv_const.term.operands.first.feature)
				switch(adv_const.term.type)
				{
					case AND: {
						throw new Exception("Not Implemented Yet")
					}
					case EQUIV: {
						result.append('''
						(constraint:$«lhs», constrained:$«rhs») isa requires_constraint;
						(constraint:$«rhs», constrained:$«lhs») isa requires_constraint;
						''')
					}
					case EXCLUDES: {
						result.append( '''(constraint:$«lhs», constrained:$«rhs») isa excludes_constraint;''')
					}
					case FEATURE: {
						throw new Exception("Not Implemented Yet")
					}
					case IMPLIES: {
						result.append( '''(constraint:$«lhs», constrained:$«rhs») isa requires_constraint;''')
					}
					case NOT: {
						throw new Exception("Not Implemented Yet")
					}
					case OR: {
						throw new Exception("Not Implemented Yet")
					}
					case XOR: {
						throw new Exception("Not Implemented Yet")
					}
					
				}
			}
			return result
		}

	def createBounds()
	{
		val Map<ContextVar, List<Pair<Literal, Literal>>> bounds = newHashMap
		for (measurement : thresholds.keySet) {
			var List<Pair<Literal,Literal>> boundPairs = newArrayList
			val sortedThresholds = thresholds.get(measurement).toList().sortWith(new LiteralComparator)
			boundPairs.add(null -> sortedThresholds.first)
			
			if(sortedThresholds.size() > 1)
			{
				for (indexedLiteral : sortedThresholds.indexed) {
					if(indexedLiteral.key + 1 <= sortedThresholds.size() - 1)
					boundPairs.add(indexedLiteral.value -> sortedThresholds.get(indexedLiteral.key + 1))
				}
			}
			
			boundPairs.add(sortedThresholds.last -> null)
			bounds.put(measurement,boundPairs)

			printBoundPairs(boundPairs)
		}
		return bounds
	}
	
	def printBoundPairs(List<Pair<Literal,Literal>> boundPairs)
	{
		for (element : boundPairs) {
			if(element.key === null)
			{
				print("(" + "," + Utilities.valueOfLiteral(element.value) + "), ")
			}
			if(element.value === null)
			{
				print("(" + Utilities.valueOfLiteral(element.key) + ",)")
			}
			if(element.value !== null && element.key !== null)
			{
				print("(" + Utilities.valueOfLiteral(element.key) + "," + Utilities.valueOfLiteral(element.value) + "), ")
			}
		}
		println("")
	}
	
	def oppositeCondition(Pair<MathOperator, Literal> opLitPair, ContextVar c_var)
	{
		var op = opLitPair.key
		var lit = opLitPair.value
		switch(op)
		{
			case MathOperator.LESS:
				return new DerivedVarLiteral(MathOperator.GREQ,c_var, lit)
			case MathOperator.LEQ:
				return new DerivedVarLiteral(MathOperator.GREATER,c_var, lit)
			case MathOperator.GREATER:
				return new DerivedVarLiteral(MathOperator.LEQ,c_var, lit)
			case MathOperator.GREQ:
				return new DerivedVarLiteral(MathOperator.LESS,c_var, lit)
			case MathOperator.DIFFERENT:
				return new DerivedVarLiteral(MathOperator.EQUAL,c_var, lit)
			case MathOperator.EQUAL:
				return new DerivedVarLiteral(MathOperator.DIFFERENT,c_var, lit)
		}
	}
			
	private def registerFeatures(Feature root)
	{
	    val visited = new LinkedHashSet<Feature>()
	    val result = new StringBuilder()
	    root.collectPostOrder(visited)
	    visited.forEach[ feature |
	        result.append(generateFeature(feature))
	        result.append('\n')
	    ]
	    result		
	}
	

	def void collectPostOrder(Feature feature, LinkedHashSet<Feature> visited) {
	    for (child : feature.children) {
	        child.collectPostOrder(visited)
	    }
	    visited.add(feature)
	}
	
	def CharSequence generateFeature(Feature feature) 
	{
		val result = new StringBuilder()
		result.append('''
		$«_namer.uniqueName(feature)» isa Feature, has feature_name "«feature.name»", has mandatory «feature.mandatory»;
		''')
		switch feature 
		{
			Alternative:
			{
				result.append('''
				$«_namer.uniqueName(feature)+feature.id.toLowerCase» (parent: $«_namer.uniqueName(feature)»,
					«FOR child_feature : feature.children SEPARATOR ", "»
						child: $«_namer.uniqueName(child_feature)»
					«ENDFOR»
				) isa alternative;	
				''')
			}
			OrGroup: 
			{
				result.append('''
				$«_namer.uniqueName(feature)+feature.id.toLowerCase» (parent: $«_namer.uniqueName(feature)», 
					«FOR child_feature : feature.children SEPARATOR ", "»
						child: $«_namer.uniqueName(child_feature)»
					«ENDFOR»
				) isa or_group;	
				''')
			}
			default:
				if(feature.children.size > 0)
				{
				result.append('''
				$«"feat_hier"+_namer.uniqueName(feature)» (parent: $«_namer.uniqueName(feature)», 
					«FOR child_feature : feature.children SEPARATOR ", "»
						child: $«_namer.uniqueName(child_feature)»
					«ENDFOR»
				) isa feature_hierarchy;	
				''')
				}
			

		}
		return result
	}
	
	private def compileResolution(ResolutionModel resModel)
	{
	 	 '''
			«FOR resolution : resModel.resolutions»
				«compileSingleResolution(resolution)»
			«ENDFOR»
		 '''
