	private def void collectAllFeatures(Feature feature, List<Feature> allFeatures) {
	    if(feature !== null)
	    {
		    allFeatures.add(feature);
		   	for (Feature child : feature.getChildren()) {
		            collectAllFeatures(child, allFeatures);
		    }
		}
	}
	
