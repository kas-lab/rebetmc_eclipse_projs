		val x ='''			
			$ta_«lc_tacticName» isa Tactic, has tactic_name "«tacticName»";
			«FOR resolutionModel : resolutionModels»
			«registerFeatures(gatherResolutionFeatures(resolutionModel))»	
			«ENDFOR»
