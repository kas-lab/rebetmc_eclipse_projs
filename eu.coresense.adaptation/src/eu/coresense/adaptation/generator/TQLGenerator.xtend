	private def toCNF(Expr expression)
	{
		if (!isCNFConjunction(expression) ){
			return distribute(expression)
		}

		return expression;
	}

	private def ContextVar contextVariableFromOperand(ContextOperand operand)
	{
		if(operand instanceof ContextVariableOperand)
		{
			return operand.variable
		}
		return null
	}

	private def Literal literalFromOperand(ContextOperand operand)
	{
		if(operand instanceof LiteralOperand)
		{
			return operand.literal
		}
		return null
	}

	private def recordContextThreshold(ContextVar variable, Literal literal, Map<ContextVar, Set<LiteralWrapper>> comps)
	{
		var thresholdsForVariable = comps.get(variable)
		if(thresholdsForVariable === null)
		{
			thresholdsForVariable = new HashSet<LiteralWrapper>()
			comps.put(variable, thresholdsForVariable)
		}
		thresholdsForVariable.add(new LiteralWrapper(literal))
	}

	private def recordContextComparisonThreshold(ContextComparison comparison, Map<ContextVar, Set<LiteralWrapper>> comps)
	{
		val leftVariable = contextVariableFromOperand(comparison.left)
		val rightVariable = contextVariableFromOperand(comparison.right)
		val leftLiteral = literalFromOperand(comparison.left)
		val rightLiteral = literalFromOperand(comparison.right)

		if(leftVariable !== null && rightLiteral !== null)
		{
			recordContextThreshold(leftVariable, rightLiteral, comps)
		}
		else if(leftLiteral !== null && rightVariable !== null)
		{
			recordContextThreshold(rightVariable, leftLiteral, comps)
		}
	}

	private def recordFeatureSelection(FeatureSelection selection, Map<Feature, Set<Boolean>> sels)
	{
		if(sels.get(selection.variant.feature) === null)
		{
			val Set<Boolean> newList = new HashSet<Boolean>()
			newList.add(true)
			newList.add(false)
			sels.put(selection.variant.feature, newList)
		}
	}

	private def registerComparisonsFromRule(AdaptationRule adap_rule)
	{
		if(adap_rule instanceof AtomicRule)
		{
			val ruleBody = adap_rule.ruleBody

			if(ruleBody instanceof ConditionAction)
			{
				if(ruleBody.guardCondition === null)
				{
					return
				}
				for (clause : ruleBody.guardCondition.clauses)
				{
					for (atom : clause.terms)
					{
						if(atom instanceof ContextComparison)
						{
							recordContextComparisonThreshold(atom, thresholds)
						}
						else if(atom instanceof FeatureSelection)
						{
							recordFeatureSelection(atom, featureSelections)
						}
						else
						{
							throw new IllegalArgumentException("Unsupported guard atom type: " + atom.class)
						}
					}
				}
			}

		}
	}

