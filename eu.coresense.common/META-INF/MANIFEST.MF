Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: eu.coresense.common;singleton:=true
Automatic-Module-Name: eu.coresense.common
Bundle-Version: 0.1.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: eu.coresense.common,
 eu.coresense.common.impl;uses:="org.eclipse.emf.ecore,org.eclipse.emf.ecore.impl,eu.coresense.common",
 eu.coresense.common.util;
  uses:="org.eclipse.emf.ecore,
   org.eclipse.emf.common.notify,
   org.eclipse.emf.common.notify.impl,
   eu.coresense.common,
   org.eclipse.emf.ecore.util"
Require-Bundle: org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.core.runtime,
 com.google.guava,
 org.eclipse.xtext.xbase.lib,
 org.eclipse.xtend.lib,
 org.eclipse.xtend.lib.macro,
 de.fraunhofer.ipa.ros;bundle-version="3.1.0.rc1"
Bundle-ActivationPolicy: lazy
