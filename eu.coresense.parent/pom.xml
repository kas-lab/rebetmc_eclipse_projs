<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>eu.coresense</groupId>
  <artifactId>eu.coresense.parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <tycho-version>4.0.12</tycho-version>
    <tycho.disableP2Mirrors>true</tycho.disableP2Mirrors>
    <xtextVersion>2.42.0</xtextVersion>
    <rostooling.version>3.1.0.rc2</rostooling.version>
    <fms.version>1.0.0</fms.version>
  </properties>

  <modules>
    <!-- Core -->
    <module>../eu.coresense.common</module>
    <module>../eu.coresense.common.edit</module>
    <module>../eu.coresense.common.editor</module>
    <!-- Context -->
    <module>../eu.coresense.context</module>
    <module>../eu.coresense.context.ide</module>
    <module>../eu.coresense.context.ui</module>
    <module>../eu.coresense.context.tests</module>
    <module>../eu.coresense.context.ui.tests</module>
    <!-- Requirements -->
    <module>../eu.coresense.requirements</module>
    <module>../eu.coresense.requirements.ide</module>
    <module>../eu.coresense.requirements.ui</module>
    <module>../eu.coresense.requirements.tests</module>
    <module>../eu.coresense.requirements.ui.tests</module>
    <!-- Resolution -->
    <module>../eu.coresense.resolution</module>
    <module>../eu.coresense.resolution.ide</module>
    <module>../eu.coresense.resolution.ui</module>
    <module>../eu.coresense.resolution.tests</module>
    <module>../eu.coresense.resolution.ui.tests</module>
    <!-- Variability -->
    <module>../eu.coresense.variability</module>
    <module>../eu.coresense.variability.ide</module>
    <module>../eu.coresense.variability.ui</module>
    <module>../eu.coresense.variability.tests</module>
    <module>../eu.coresense.variability.ui.tests</module>
    <!-- Adaptation (depends on featureidewrapper — must come after) -->
    <module>../featureidewrapper</module>
    <module>../eu.coresense.adaptation</module>
    <module>../eu.coresense.adaptation.ide</module>
    <module>../eu.coresense.adaptation.ui</module>
    <module>../eu.coresense.adaptation.tests</module>
    <module>../eu.coresense.adaptation.ui.tests</module>
    <!-- Support -->
    <module>../RosToolingSupport</module>
    <!-- Feature + repository -->
    <module>../eu.coresense.feature</module>
    <module>../eu.coresense.repository</module>
  </modules>

  <!-- p2 repositories (Eclipse platform bundles) -->
  <repositories>
    <repository>
      <id>eclipse-2025-12</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2025-12/</url>
    </repository>
    <repository>
      <id>eclipse-platform-4.38</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/eclipse/updates/4.38</url>
    </repository>
    <repository>
      <id>xtext-2.42.0</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/modeling/tmf/xtext/updates/releases/${xtextVersion}/</url>
    </repository>
    <repository>
      <id>orbit-2025-12</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/2025-12/</url>
    </repository>
    <!-- Maven repositories consumed as OSGi bundles via pomDependencies=consider -->
    <repository>
      <id>kas-lab-rostooling</id>
      <url>https://maven.pkg.github.com/kas-lab/RosTooling</url>
    </repository>
    <repository>
      <id>kas-lab-splc2020</id>
      <url>https://maven.pkg.github.com/kas-lab/splc2020</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>de.fraunhofer.ipa.ros</groupId>
      <artifactId>de.fraunhofer.ipa.ros</artifactId>
      <version>${rostooling.version}</version>
    </dependency>
    <dependency>
      <groupId>de.fraunhofer.ipa.ros</groupId>
      <artifactId>de.fraunhofer.ipa.rossystem</artifactId>
      <version>${rostooling.version}</version>
    </dependency>
    <dependency>
      <groupId>de.fraunhofer.ipa.ros</groupId>
      <artifactId>de.fraunhofer.ipa.ros.xtext</artifactId>
      <version>${rostooling.version}</version>
    </dependency>
    <dependency>
      <groupId>de.fraunhofer.ipa.ros</groupId>
      <artifactId>de.fraunhofer.ipa.ros.xtext.ide</artifactId>
      <version>${rostooling.version}</version>
    </dependency>
    <dependency>
      <groupId>de.fraunhofer.ipa.ros</groupId>
      <artifactId>de.fraunhofer.ipa.ros.xtext.ui</artifactId>
      <version>${rostooling.version}</version>
    </dependency>
    <dependency>
      <groupId>uma.caosd</groupId>
      <artifactId>fms.metamodel</artifactId>
      <version>${fms.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho-version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho-version}</version>
        <configuration>
          <target>
            <file>${project.basedir}/../eu.coresense.releng.target/rebetmc-2026-03.target</file>
          </target>
          <pomDependencies>consider</pomDependencies>
          <executionEnvironment>JavaSE-21</executionEnvironment>
          <environments>
            <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
            <environment><os>macosx</os><ws>cocoa</ws><arch>x86_64</arch></environment>
            <environment><os>win32</os><ws>win32</ws><arch>x86_64</arch></environment>
          </environments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-surefire-plugin</artifactId>
        <version>${tycho-version}</version>
        <configuration>
          <failIfNoTests>false</failIfNoTests>
          <useUIHarness>false</useUIHarness>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-compiler-plugin</artifactId>
        <version>${tycho-version}</version>
        <configuration>
          <compilerArgument>-err:-forbidden</compilerArgument>
          <useProjectSettings>false</useProjectSettings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-packaging-plugin</artifactId>
        <version>${tycho-version}</version>
        <configuration>
          <forceContextQualifier>SNAPSHOT</forceContextQualifier>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.4</version>
        <configuration>
          <deployAtEnd>true</deployAtEnd>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
