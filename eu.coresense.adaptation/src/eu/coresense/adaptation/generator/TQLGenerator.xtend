	private def checkAgainstBounds(AdaptationRule adap_rule, List<ContextVar> contextKeys, List<Feature> featureKeys, State state)
	{
		if(adap_rule instanceof AtomicRule)
		{
			val ruleBody = adap_rule.ruleBody
			if(ruleBody instanceof ConditionAction)
			{
				return guardSatisfied(ruleBody.guardCondition, contextKeys, featureKeys, state)
			}
			return true
		}
		return false
	}

	private def boolean guardSatisfied(GuardCNF cnf, List<ContextVar> contextKeys, List<Feature> featureKeys, State state)
	{
		if(cnf === null)
		{
			return true
		}
		return cnf.clauses.forall[clause |
			clause.terms.exists[atom |
				atomSatisfied(atom, contextKeys, featureKeys, state)
			]
		]
	}

	private def boolean atomSatisfied(GuardAtom atom, List<ContextVar> contextKeys, List<Feature> featureKeys, State state)
	{
		if(atom instanceof FeatureSelection)
		{
			return featureSelectionSatisfied(atom, featureKeys, state)
		}
		if(atom instanceof ContextComparison)
		{
			return contextComparisonSatisfied(atom, state)
		}
		throw new IllegalArgumentException("Unsupported guard atom type: " + atom.class)
	}

	private def boolean featureSelectionSatisfied(FeatureSelection selection, List<Feature> featureKeys, State state)
	{
		val featureIndex = featureKeys.indexOf(selection.variant.feature)
		if(featureIndex < 0)
		{
			return false
		}
		val selected = state.featurePrecondition.get(featureIndex)
		if(selection.not === null)
		{
			return selected == true
		}
		return selected != true
	}

	private def boolean contextComparisonSatisfied(ContextComparison comparison, State state)
	{
		val leftVariable = contextVariableFromOperand(comparison.left)
		val rightVariable = contextVariableFromOperand(comparison.right)
		val leftLiteral = literalFromOperand(comparison.left)
		val rightLiteral = literalFromOperand(comparison.right)

		if(leftVariable !== null && rightLiteral !== null)
		{
			return contextIntervalSatisfies(leftVariable, comparison.operator, new LiteralWrapper(rightLiteral), state)
		}
		if(leftLiteral !== null && rightVariable !== null)
		{
			return contextIntervalSatisfies(rightVariable, flipOperator(comparison.operator), new LiteralWrapper(leftLiteral), state)
		}
		if(leftLiteral !== null && rightLiteral !== null)
		{
			return literalComparisonSatisfied(new LiteralWrapper(leftLiteral), comparison.operator, new LiteralWrapper(rightLiteral))
		}
		if(leftVariable !== null && rightVariable !== null)
		{
			throw new UnsupportedOperationException("ContextVar-to-ContextVar guard satisfaction is not supported for state bounds")
		}
		throw new IllegalArgumentException("Unsupported context comparison operands")
	}

	private def MathOperator flipOperator(MathOperator operator)
	{
		switch operator {
			case MathOperator.GREATER: MathOperator.LESS
			case MathOperator.GREQ: MathOperator.LEQ
			case MathOperator.LESS: MathOperator.GREATER
			case MathOperator.LEQ: MathOperator.GREQ
			case MathOperator.EQUAL: MathOperator.EQUAL
			case MathOperator.DIFFERENT: MathOperator.DIFFERENT
		}
	}

	private def boolean contextIntervalSatisfies(ContextVar variable, MathOperator operator, LiteralWrapper thresholdValue, State state)
	{
		val bound = state.getBoundsOn(variable)
		if(bound === null)
		{
			return false
		}
		val closedLowerBound = bound.key
		val openUpperBound = bound.value
		switch operator {
			case MathOperator.GREATER:
				return closedLowerBound !== null && closedLowerBound >= thresholdValue
			case MathOperator.GREQ:
				return closedLowerBound !== null && closedLowerBound >= thresholdValue
			case MathOperator.LESS:
				return openUpperBound !== null && openUpperBound <= thresholdValue
			case MathOperator.LEQ:
				return openUpperBound !== null && openUpperBound <= thresholdValue
			case MathOperator.EQUAL:
				return false
			case MathOperator.DIFFERENT:
				return false
		}
	}

	private def boolean literalComparisonSatisfied(LiteralWrapper left, MathOperator operator, LiteralWrapper right)
	{
		switch operator {
			case MathOperator.GREATER:
				return left > right
			case MathOperator.GREQ:
				return left >= right
			case MathOperator.LESS:
				return left < right
			case MathOperator.LEQ:
				return left <= right
			case MathOperator.EQUAL:
				return left == right
			case MathOperator.DIFFERENT:
				return left != right
		}
	}

	def boolean operator_lessThan(Literal literal, Literal literal2)
	{
		switch obj : literal {
            IntLiteral:     obj.value < (literal2 as IntLiteral).value
            DecimalLiteral: obj.value < (literal2 as DecimalLiteral).value
            StringLiteral:  obj.value < (literal2 as StringLiteral).value
            BooleanLiteral: obj.value < (literal2 as BooleanLiteral).value
            default:        false
        }
	}

	private def compileRule(AdaptationRule c, String lc_tacticName, boolean doingStates)
	{
	if (c instanceof AtomicRule)
	{
		val ruleName = c.name
		val lc_ruleName = c.name.toLowerCase
		val ruleBody = c.ruleBody

		if(ruleBody instanceof ConditionAction)
		{

			val hasAntecedent = ruleBody.guardCondition !== null
			val pair = if(hasAntecedent) createAntecedent(ruleBody.guardCondition) else "" -> ""
			val ant_name = pair.key
			val ant = pair.value
		//TODO: Below, .get(0) should of course be replaced with parsing all the actions.
		//_namer.uniqueName(c.ruleBody.atomicAction.actions.get(0).variant.feature)
		'''
					«IF !doingStates && hasAntecedent» «ant» «ENDIF»
					«val someName = lc_ruleName + "fa"»
					$«someName» (
					«FOR action : c.ruleBody.atomicAction.actions SEPARATOR ", "»
					«IF action instanceof AtomicActionSelectFeature»
					activation: $«_namer.uniqueName(action.variant.feature)»
					«ENDIF»
					«IF action instanceof AtomicActionDeselectFeature»
					deactivation: $«_namer.uniqueName(action.variant.feature)»
					«ENDIF»
					«ENDFOR»
					) isa feature_adaptation;
«««					$tactic_rule_«lc_ruleName» (tactic:$ta_«lc_tacticName», antecedent:$«ant_name», consequent:$«_namer.uniqueName(c.ruleBody.atomicAction.actions.get(0).variant.feature)» ) isa tactic_rule, has rule_name "«ruleName»";

					«IF ruleBody.effect !== null»
						«EffectHandling(ruleBody.effect.someEffect, ruleName, doingStates)»
						$tactic_rule_«lc_ruleName» (tactic:$ta_«lc_tacticName», «IF !doingStates && hasAntecedent» antecedent:$«ant_name», «ENDIF» consequent:$«someName», effect:$rel_effect_«ruleName.toLowerCase») isa tactic_rule, has rule_name "«ruleName»";
					«ELSE»
						$tactic_rule_«lc_ruleName» (tactic:$ta_«lc_tacticName»,  «IF !doingStates && hasAntecedent» antecedent:$«ant_name», «ENDIF» consequent:$«someName») isa tactic_rule, has rule_name "«ruleName»";
					«ENDIF»
		'''

		}




	}
	}

	def isPositive(RelativeEffect rel_effect)
	{
		return (rel_effect.sign == "+")
	}

	def Boolean greaterThanBound(LiteralWrapper literal, LiteralWrapper comparator)
	{
		if(comparator === null)
		{
			return true
		}
		return literal > comparator
	}

	def Boolean lessThanBound(LiteralWrapper literal, LiteralWrapper comparator)
	{
		if(comparator === null)
		{
			return true
		}
		return literal < comparator
	}


	def findNextState(LiteralWrapper affectedValue, ContextVar contextVar, State currentState)
	{
		val currentFeatureState = currentState.featurePrecondition
		for (potentialState : allStates) {
			val nextFeatureState = potentialState.featurePrecondition
			if(currentFeatureState == nextFeatureState) //Potential state has the same feature precondition
			{
				val relevantInterval = potentialState.getBoundsOn(contextVar)

				val lowerBound = relevantInterval.key
				val upperBound = relevantInterval.value

				if(greaterThanBound(affectedValue, lowerBound) && lessThanBound(affectedValue, upperBound)) //Potential state is satisfied by new value of affect contextVar
				{
					val otherContextVars = currentState.contextKeys.filter[element | element != contextVar]
					val othersMatch = otherContextVars.forall[element | currentState.getBoundsOn(element) == potentialState.getBoundsOn(element)]
				    if (othersMatch)
				    {
				       return potentialState
				    }
				}
			}
		}
		throw new Exception("No next state could be found, states do not fully cover context var values.")
	}


	def String EffectHandling(Effect effect, String ruleName, Boolean doStates)
	{
		if(effect instanceof RelativeEffect)
		{
			val prefix = ruleName.toLowerCase + "_effect"
			var returnString = '''
			«literalValue(effect.effectValue, prefix).value»
			$rel_effect_«ruleName.toLowerCase» (measure: $«_namer.uniqueName(effect.measurement)», effect_value:$«prefix + "_val"») isa relative_effect;
			'''

			if(doStates)
			{
				for (state : allStates) {
//				    val contextualState = contextFeaturePair.contextPrecondition
//				    val relevantContextKeyIndex = contextKeys.indexOf(effect.measurement)
				    val relevantInterval = state.getBoundsOn(effect.measurement)
				    val lowerBound = relevantInterval.key
				    val upperBound = relevantInterval.value

				    val escaped = if (isPositive(effect)) {
				        if (lowerBound === null || upperBound === null) null
				        else {
				            val attempt = new LiteralWrapper(effect.effectValue) + lowerBound
				            if (attempt > upperBound) attempt else null
				        }
				    } else {
				        if (upperBound === null || lowerBound === null) null
				        else {
				            val attempt = upperBound + new LiteralWrapper(effect.effectValue)
				            if (attempt < lowerBound) attempt else null
				        }
				    }

				    if (escaped !== null) {
				        println("state Escaped!!")
				        val nextState = findNextState(escaped, effect.measurement, state)
				        println("next state found: " + nextState.TQLName)
				        escapes.put(state.TQLName -> ruleName, nextState.TQLName)
				    }
				}
			}

			return returnString
		}
	}

	def List<Expr> flattenAnds(Expr e) {
    switch e {
        And: {
            val leftClauses  = flattenAnds(e.left)
            val rightClauses = flattenAnds(e.right)
            (leftClauses + rightClauses).toList
        }
        default:
            #[e]  // single clause
    }
}

	def Pair<String, String> compileDisjunct(GuardDisjunct disjunct) {
		val compiledTerms = disjunct.terms.map[compileAtom(it)].toList
		if(compiledTerms.empty)
		{
			throw new IllegalArgumentException("GuardDisjunct has no terms")
		}
		if(compiledTerms.size == 1)
		{
			val term = compiledTerms.get(0)
			return term.key -> term.value.toString
		}

		val name = _namer.uniqueName(disjunct)
		val x = '''
		«FOR element : compiledTerms»
			«element.value»
		«ENDFOR»
		$«name» (
		«FOR element : compiledTerms SEPARATOR ", "»
		expression:$«element.key»
		«ENDFOR»
		) isa or_expression, has expression_name "«name»";
		'''

		return name -> x.toString
	}

	def Pair<String, String> createAntecedent(GuardCNF cnf) {
		val compiledClauses = cnf.clauses.map[compileDisjunct(it)].toList
		if(compiledClauses.empty)
		{
			throw new IllegalArgumentException("GuardCNF has no clauses")
		}
		if(compiledClauses.size == 1)
		{
			return compiledClauses.get(0)
		}

		val name = _namer.uniqueName(cnf)
		val x = '''
		«FOR element : compiledClauses»
			«element.value»
		«ENDFOR»
		$«name» (
		«FOR element : compiledClauses SEPARATOR ", "»
		expression:$«element.key»
		«ENDFOR»
		) isa and_expression, has expression_name "«name»";
		'''

		return name -> x.toString
	}

	def Pair<String, String> compileDerivedStateExpression(Expr e) {
		switch e {
			DerivedVar: {
				val compiled = inequality(e.measurement, e.thresholdValue, e.operator)
				return compiled.key -> compiled.value.toString
			}
			DerivedVarFeature: {
				val compiled = inequality(e)
				return compiled.key -> compiled.value.toString
			}
			Or: throw new UnsupportedOperationException("OR expressions are not supported in derived state antecedents")
			And: throw new IllegalArgumentException("did not expect an AND from flattened ANDs")
			default: throw new IllegalArgumentException("Unsupported derived state expression: " + e.class.simpleName)
		}
	}

	def Pair<String, String> createAntecedent(Expr e) {
    	switch e {
    		DerivedVar: return compileDerivedStateExpression(e)
    		DerivedVarFeature: return compileDerivedStateExpression(e)
	        Or: throw new UnsupportedOperationException("OR expressions are not supported in derived state antecedents")
	        And: {
	        	var flattenedAnds = flattenAnds(e)
	        	var handled = flattenedAnds.map[compileDerivedStateExpression(it)].toList
	        	val name = uniqueName(e)
				val x = '''
				«FOR element : handled»
					«element.value»
				«ENDFOR»
				$«name» (
		    	«FOR element : handled SEPARATOR ", "»
«««		    	«val nammee = _namer.uniqueName(e)»
		    	expression:$«element.key»
		    	«ENDFOR»
		    	) isa and_expression;
				'''

				return name -> x.toString
	    	}
	    	default: throw new IllegalArgumentException("Unsupported derived state antecedent: " + e.class.simpleName)
		}
	}


	def Expr distribute(Expr e) {
    	switch e {

	        Or: {
	            val A = distribute(e.left)
	            val B = distribute(e.right)

	            // A ∨ (B ∧ C) → (A ∨ B) ∧ (A ∨ C)
	            if (B instanceof And) {
	                return new And(
	                    distribute(new Or(A, B.left)),
	                    distribute(new Or(A, B.right))
	                )
	            }

	            // (A ∧ B) ∨ C → (A ∨ C) ∧ (B ∨ C)
	            if (A instanceof And) {
	                return new And(
	                    distribute(new Or(A.left, B)),
	                    distribute(new Or(A.right, B))
	                )
	            }

	            // Otherwise it's just OR of two non-ANDs
	            return new Or(A, B)
	        }

	        And: {
	            // Push distribute through both sides
	            val L = distribute(e.left)
	            val R = distribute(e.right)
	            return new And(L, R)
	        }

	        default:
	            // Leaf or unknown expression.
	            return e
	    }
	}


}



