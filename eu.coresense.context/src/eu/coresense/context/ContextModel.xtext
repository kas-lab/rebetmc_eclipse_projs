grammar eu.coresense.context.ContextModel with de.fraunhofer.ipa.ros.Basics

generate contextModel "http://www.coresense.eu/context/ContextModel"
import "http://www.ipa.fraunhofer.de/ros" as ros
import "http://www.eclipse.org/emf/2002/Ecore" as ecore


ContextModel:
	(imports+=Import*)
	context_variables+=ContextVar*;

ContextVar:
	'ContextVariable' name=ID
	'{'
		source=DataSource
		'cache?' doCache=DoCache
		('cache' 'length' length=INT 's')?
		('period' period=INT 'ns')?
		('proxy' doProxy=DoProxy)?
		'function_name' functionName=STRING
		('function_lib' functionLibrary=STRING)?
	'}';

DoCache:
	{DoCache} do=BOOLEAN
;

DoProxy:
	{DoProxy} do=BOOLEAN
;

DataSource:
	'source:'
    (
        'origin:'ref=QualifiedRef 
    )
;

KeyWordArguments:
	STRING
;

QualifiedRef:
	QualifiedPublisherRef | QualifiedServiceServerRef | QualifiedActionServerRef
;
QualifiedPublisherRef:
    'publisher:' node=[ros::Node|RosNames] '.' publisher=[ros::Publisher|RosNames]
;

QualifiedServiceServerRef:
    'service:' node=[ros::Node|RosNames] '.' serviceServer=[ros::ServiceServer|RosNames] 'request_kwargs' kwargs=KeyWordArguments
;

QualifiedActionServerRef:
    'action:' node=[ros::Node|RosNames] '.' actionServer=[ros::ActionServer|RosNames] 'goal_kwargs' kwargs=KeyWordArguments
;

Import:
	'import' importURI=STRING ';'
;
