grammar eu.coresense.context.ContextModel with org.eclipse.xtext.common.Terminals

generate contextModel "http://www.coresense.eu/context/ContextModel"
import "http://www.ipa.fraunhofer.de/ros" as ros
import "http://www.eclipse.org/emf/2002/Ecore" as ecore


ContextModel:
	(imports+=Import*)
	context_variables+=ContextVar*;

ContextVar:
	'ContextVariable' name=ID
	'{'
		source=DataSource
		'cache?' doCache=DoCache
		('cache' 'length' length=INT 's')?
		('period' period=INT 'ns')?
		('proxy' doProxy=DoProxy)?
		'function_name' functionName=STRING
		('function_lib' functionLibrary=STRING)?
	'}';

DoCache:
	{DoCache} do=BOOLEAN
;

DoProxy:
	{DoProxy} do=BOOLEAN
;

DataSource:
	'source:'
    (
        'publisher:' 'ref:'ref=QualifiedPublisherRef
      | 'service:' 'ref:' ref=QualifiedServiceServerRef 'request_kwargs:' kwargs=KeyWordArguments
      | 'action:' 'ref:' ref=QualifiedActionServerRef 'goal_kwargs:' kwargs=KeyWordArguments
    )
;

KeyWordArguments:
	STRING
;

QualifiedPublisherRef:
    node=[ros::Node] '.' publisher=[ros::Publisher]
;

QualifiedServiceServerRef:
    node=[ros::Node] '.' serviceServer=[ros::ServiceServer]
;

QualifiedActionServerRef:
    node=[ros::Node] '.' actionServer=[ros::ActionServer]
;

Import:
	'import' importURI=STRING ';'
;


terminal BOOLEAN returns ecore::EBoolean:
    'true' | 'false'
;