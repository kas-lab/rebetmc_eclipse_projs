<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="contextModel" nsURI="http://www.coresense.eu/context/ContextModel"
    nsPrefix="contextModel">
  <eClassifiers xsi:type="ecore:EClass" name="ContextModel">
    <eStructuralFeatures xsi:type="ecore:EReference" name="imports" upperBound="-1"
        eType="ecore:EClass ../../../eu.coresense.common/model/common.ecore#//Import"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="environmental_variables"
        upperBound="-1" eType="#//ContextVar" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ContextVar">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1"
        eType="#//DataSource" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" eType="ecore:EClass ../../../de.fraunhofer.ipa.ros/model/PrimitivesTypes.ecore#//AbstractType"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="doCache" eType="#//DoCache"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="length" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="period" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="doProxy" eType="#//DoProxy"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="functionName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="functionLibrary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="functionArgs" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="thresholds" upperBound="-1"
        eType="ecore:EClass ../../../eu.coresense.common/model/common.ecore#//Literal"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DoCache">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="do" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DoProxy">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="do" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DataSource">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ref" lowerBound="1" eType="#//Reference"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Reference"/>
  <eClassifiers xsi:type="ecore:EClass" name="CompositeRef" eSuperTypes="#//Reference">
    <eStructuralFeatures xsi:type="ecore:EReference" name="contextVars" unique="false"
        lowerBound="1" upperBound="-1" eType="#//ContextVar"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedRef" eSuperTypes="#//Reference">
    <eStructuralFeatures xsi:type="ecore:EReference" name="node" eType="ecore:EClass ../../../de.fraunhofer.ipa.rossystem/model/rossystem.ecore#//RosNode"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedPublisherRef" eSuperTypes="#//QualifiedRef">
    <eStructuralFeatures xsi:type="ecore:EReference" name="publisher" eType="ecore:EClass ../../../de.fraunhofer.ipa.ros/model/ros.ecore#//Publisher"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedServiceServerRef" eSuperTypes="#//QualifiedRef">
    <eStructuralFeatures xsi:type="ecore:EReference" name="serviceServer" eType="ecore:EClass ../../../de.fraunhofer.ipa.ros/model/ros.ecore#//ServiceServer"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kwargs" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QualifiedActionServerRef" eSuperTypes="#//QualifiedRef">
    <eStructuralFeatures xsi:type="ecore:EReference" name="actionServer" eType="ecore:EClass ../../../de.fraunhofer.ipa.ros/model/ros.ecore#//ActionServer"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kwargs" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
</ecore:EPackage>
